CONTEXT_SERVER_URL=http://127.0.0.1:8787
CONTEXT_SERVER_TOKEN=ctx_local_token
CONTEXT_MCP_MODE=read
CONTEXT_MCP_TRANSPORT=stdio
CONTEXT_MCP_HTTP_HOST=127.0.0.1
CONTEXT_MCP_HTTP_PORT=8789
CONTEXT_MCP_HTTP_PATH=/mcp
# Required only for CONTEXT_MCP_TRANSPORT=streamable-http.
# CONTEXT_MCP_HTTP_TOKEN=replace-with-a-separate-mcp-bearer-token
CONTEXT_MCP_TIMEOUT_MS=10000
